      "seed": "node scripts/screenshots-seed.mjs --instance single",
      "admin": "http://gateway.acme.example:9097",
      "data": "http://gateway.acme.example:8087",
      "loopback": {
        "admin": "http://127.0.0.1:9097",
        "data": "http://127.0.0.1:8087"
