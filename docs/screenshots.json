{
  "_why": "Where every screenshot on this site comes from, so a screen that moved can be retaken instead of guessed at. The loop is in scripts/screenshots.mjs.",
  "instance": {
    "build": "CGO_ENABLED=0 go build -tags ee -o /tmp/meerkat-doc ./cmd/meerkat",
    "console": "the binary must EMBED the console, or the admin port answers a JSON status page: make ui first, or stage console/dist/console/browser into internal/admin/ui/dist",
    "run": "MEERKAT_TENANCY=multi MEERKAT_ADMIN_PASSWORD=test1234 /tmp/meerkat-doc -addr 127.0.0.1:8086 -admin-addr 127.0.0.1:9096 -data /tmp/docdata",
    "ports": "8086 and 9096 on purpose: this repository's own dev instance runs on 8082 and 9092 and must never be disturbed",
    "admin": "http://127.0.0.1:9096",
    "data": "http://127.0.0.1:8086",
    "signIn": "admin / test1234",
    "dataset": "Acme Corp: five routes, a role hierarchy with tags, four users, three groups, a vault with three entries, a portal, two certificates. orders-api carries a deposited OpenAPI spec of 14 operations and three endpoint rules - that is what the endpoint-security captures show.",
    "upstream": "two routes point at a local Node upstream on 127.0.0.1:8099, so the traffic screen shows answers rather than 502s"
  },
  "convert": "cwebp -quiet -q 82 -resize 1600 0 <shot>.png -o public/<file>",
